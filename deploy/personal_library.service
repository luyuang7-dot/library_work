[Unit]
Description=Personal Library Flask App
After=network.target mysql.service
OnFailure=personal_library-alert@%n.service

[Service]
Type=simple
User=library
Group=www-data
WorkingDirectory=/opt/personal_library/current
EnvironmentFile=/opt/personal_library/current/.env
Environment=FLASK_ENV=prod
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/personal_library/current/.venv/bin/gunicorn --workers 2 --threads 4 --bind 127.0.0.1:8000 --timeout 300 --graceful-timeout 30 --access-logfile - --error-logfile - wsgi:app
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
