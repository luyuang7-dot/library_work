FLASK_ENV=dev
FLASK_SECRET_KEY=replace-with-a-long-random-secret
AI_AGENT_API_KEY_ENCRYPTION_KEY=replace-with-32-byte-random-key
DATABASE_URL=mysql+pymysql://root:replace-with-db-password@localhost:3306/library_work?charset=utf8mb4

UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=209715200
DEFAULT_MINERU_URL=http://127.0.0.1:8000

LOGIN_RATE_LIMIT=5 per 15 minutes
RATELIMIT_STORAGE_URI=memory://
REQUEST_LOGGING_ENABLED=true
REQUEST_ID_HEADER=X-Request-ID

# Optional production overrides
# APP_VERSION=0.5.1
# SESSION_COOKIE_DOMAIN=.example.com
# REMEMBER_COOKIE_DOMAIN=.example.com
